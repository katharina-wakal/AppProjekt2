<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>SettingsWindow</class>
 <widget class="QWidget" name="SettingsWindow">
  <property name="geometry">
   <rect>
    <x>0</x>
    <y>0</y>
    <width>387</width>
    <height>980</height>
   </rect>
  </property>
  <property name="windowTitle">
   <string>FemHealth – Einstellungen</string>
  </property>
  <property name="styleSheet">
   <string notr="true">
QWidget#SettingsWindow { background-color: #FDF6F0; font-family: &quot;Segoe UI&quot;, Arial, sans-serif; }
QWidget#scrollContents { background-color: #FDF6F0; }

/* ── Header ── */
QPushButton#btnBack {
    background-color: #F0F0F0; color: #9E9E9E;
    border-radius: 20px; font-size: 16px; font-weight: bold; border: none;
}
QPushButton#btnBack:hover { background-color: #FCE4EC; color: #E91E63; }
QLabel#lblTitle {
    color: #E91E63; font-size: 22px; font-weight: bold; background: transparent;
}
QLabel#lblSubtitle {
    color: #9E9E9E; font-size: 12px; background: transparent;
}

/* ── Gruppen-Header ── */
QLabel#lblGrpAccount, QLabel#lblGrpApp,
QLabel#lblGrpDaten, QLabel#lblGrpRechtliches {
    color: #880E4F; font-size: 13px; font-weight: 700;
    letter-spacing: 0.5px; background: transparent;
}

/* ── Settings-Karten ── */
QFrame#cardAccount, QFrame#cardApp,
QFrame#cardDaten, QFrame#cardRechtliches {
    background-color: #FFFFFF;
    border-radius: 18px;
    border: 1px solid #F8BBD9;
}

/* ── Zeilen-Buttons ── */
QPushButton[settingsRow=&quot;true&quot;] {
    background-color: transparent;
    color: #333333;
    border: none;
    border-radius: 0px;
    font-size: 14px;
    text-align: left;
    padding: 0px 14px;
    min-height: 48px;
}
QPushButton[settingsRow=&quot;true&quot;]:hover { background-color: #FFF5F8; }
QPushButton[settingsRow=&quot;true&quot;]:pressed { background-color: #FCE4EC; }

/* ── Trennlinien in Karten ── */
QFrame[rowDivider=&quot;true&quot;] {
    background: #F8BBD9; max-height: 1px; min-height: 1px; border: none;
    margin-left: 14px; margin-right: 14px;
}

/* ── Pfeil-Labels ── */
QLabel[chevron=&quot;true&quot;] {
    color: #BDBDBD; font-size: 18px; background: transparent;
}

/* ── Icon-Labels ── */
QLabel[settingsIcon=&quot;true&quot;] {
    font-size: 18px; background: transparent;
    min-width: 28px; max-width: 28px;
}

/* ── Toggle-Switches (CheckBox als Toggle) ── */
QCheckBox[toggle=&quot;true&quot;] {
    spacing: 0px;
}
QCheckBox[toggle=&quot;true&quot;]::indicator {
    width: 44px; height: 26px;
    border-radius: 13px;
    background-color: #E0E0E0;
    border: none;
}
QCheckBox[toggle=&quot;true&quot;]::indicator:checked {
    background-color: #E91E63;
}

/* ── Abmelden / Löschen-Buttons ── */
QPushButton#btnAbmelden {
    background-color: transparent; color: #FF9800;
    border: none; font-size: 14px; text-align: left;
    padding: 0px 14px; min-height: 48px;
}
QPushButton#btnAbmelden:hover { background-color: #FFF3E0; }
QPushButton#btnLoeschen {
    background-color: transparent; color: #F44336;
    border: none; font-size: 14px; text-align: left;
    padding: 0px 14px; min-height: 48px;
}
QPushButton#btnLoeschen:hover { background-color: #FFEBEE; }

/* ── Scroll ── */
QScrollArea { background: transparent; border: none; }
QScrollBar:vertical { width: 4px; background: #F8BBD9; border-radius: 2px; }
QScrollBar::handle:vertical { background: #F48FB1; border-radius: 2px; min-height: 20px; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QScrollBar:horizontal { height: 0px; }
   </string>
