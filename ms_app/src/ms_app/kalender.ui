  </property>
  <property name="windowTitle">
   <string>Kalender – FemHealth</string>
  </property>
  <property name="styleSheet">
   <string notr="true">
/* ══ Global ══ */
QWidget#KalenderWindow {
    background-color: #FDF6F0;
    font-family: &quot;Segoe UI&quot;, Arial, sans-serif;
}

/* ══ Header – rosa Gradient wie Dashboard ══ */
QFrame#headerFrame {
    background-color: qlineargradient(
        spread:pad, x1:0, y1:0, x2:1, y2:1,
        stop:0 #FCE4EC, stop:0.5 #F8BBD9, stop:1 #F48FB1
    );
    border: none;
}
QPushButton#btnBack {
    background-color: rgba(255,255,255,0.35);
    border: none;
    border-radius: 18px;
    color: #880E4F;
    font-size: 20px;
    font-weight: bold;
}
QPushButton#btnBack:hover { background-color: rgba(255,255,255,0.55); }
QPushButton#btnBack:pressed { background-color: rgba(255,255,255,0.75); }

QLabel#lblTitle {
    color: #FFFFFF;
    font-size: 18px;
    font-weight: bold;
    background: transparent;
}
QLabel#lblDrop {
    color: #E91E63;
    font-size: 20px;
    background: transparent;
}

/* ══ Wochentag-Header ══ */
QLabel#lblWdM, QLabel#lblWdD1, QLabel#lblWdM2,
QLabel#lblWdD2, QLabel#lblWdF, QLabel#lblWdS1, QLabel#lblWdS2 {
    color: #C2A0AD;
    font-size: 11px;
    font-weight: 600;
    background: transparent;
}

/* ══ Monats-Label ══ */
QLabel#lblMonthName {
    color: #880E4F;
    font-size: 14px;
    font-weight: bold;
    background: transparent;
    padding: 8px 0 4px;
}

/* ══ Scroll-Bereich ══ */
QScrollArea#calScrollArea {
    background: transparent;
    border: none;
}
QScrollArea#calScrollArea > QWidget > QWidget {
    background: transparent;
}
QScrollBar:vertical {
    width: 4px;
    background: #F8BBD9;
    border-radius: 2px;
}
QScrollBar::handle:vertical {
    background: #F48FB1;
    border-radius: 2px;
    min-height: 20px;
}
QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical { height: 0; }

/* ══ Tag-Buttons ══ */
QPushButton.dayBtn {
    background: transparent;
    border: none;
    border-radius: 10px;
    font-size: 13px;
    font-weight: 500;
    color: #4A0010;
    min-height: 40px;
    max-height: 40px;
}
QPushButton.dayBtn:hover { background: #FCE4EC; }

/* Heute */
QPushButton.dayToday {
    color: #E91E63;
    font-weight: 700;
    border: 2px solid #E91E63;
    border-radius: 10px;
}

/* Perioden-Block (rot durchgehend) */
QPushButton.dayPeriod {
    background-color: #E91E63;
    color: #FFFFFF;
    font-weight: 600;
    border-radius: 2px;
}
QPushButton.dayPeriodStart { border-radius: 10px 2px 2px 10px; }
QPushButton.dayPeriodEnd   { border-radius: 2px 10px 10px 2px; }
QPushButton.dayPeriod:hover { background-color: #C2185B; }

/* Eisprung-Zone (hellblau wie original .ui) */
QPushButton.dayOvulation {
    background-color: #E3F2FD;
    color: #1565C0;
    border-radius: 2px;
}
QPushButton.dayOvulationStart { border-radius: 10px 2px 2px 10px; }
QPushButton.dayOvulationEnd   { border-radius: 2px 10px 10px 2px; }
QPushButton.dayOvulation:hover { background-color: #BBDEFB; }

/* Zukunft ausgegraut */
QPushButton.dayFuture {
    color: #CBA8B5;
}
QPushButton.dayFuture:hover { background: transparent; }

/* ══ Trenn-Linie ══ */
QFrame#divider {
    background-color: #F8BBD9;
    max-height: 1px;
    min-height: 1px;
    border: none;
}

/* ══ Detail-Sheet unten (weiß wie Dashboard-Cards) ══ */
QFrame#sheetFrame {
    background-color: #FFFFFF;
    border-top: 1.5px solid #F8BBD9;
    border-top-left-radius: 20px;
    border-top-right-radius: 20px;
}
QLabel#sheetHandle {
    background: #F8BBD9;
    border-radius: 2px;
    max-height: 4px;
    min-height: 4px;
    max-width: 40px;
    min-width: 40px;
}

/* "Getrackt am 26. Mai" */
QLabel#sheetDate {
    color: #880E4F;
    font-size: 15px;
    font-weight: bold;
    background: transparent;
}

/* "Zyklustag 22" rechts */
QLabel#sheetCycleDay {
    color: #F48FB1;
    font-size: 12px;
    font-weight: 600;
    background: transparent;
}

/* Phasenname */
QLabel#sheetPhase {
    color: #AD1457;
    font-size: 13px;
    font-weight: 600;
    background: transparent;
}

/* Placeholder-Text */
QLabel#sheetEmpty {
    color: #BDBDBD;
    font-size: 13px;
    background: transparent;
}

/* "Mehr erfahren"-Button – Chip-Stil wie News-Filter im Dashboard */
QPushButton#btnMehrErfahren {
    background-color: #FCE4EC;
    color: #AD1457;
    border: 1.5px solid #F48FB1;
    border-radius: 20px;
    font-size: 12px;
    font-weight: 600;
    padding: 4px 14px;
    min-height: 32px;
}
QPushButton#btnMehrErfahren:hover { background-color: #F8BBD9; }

/* Haupt-Tracken-Button – groß, rosa ausgefüllt */
QPushButton#btnTracken {
    background-color: #E91E63;
    color: #FFFFFF;
    border: none;
    border-radius: 24px;
    font-size: 16px;
    font-weight: 700;
    min-height: 52px;
}
QPushButton#btnTracken:hover { background-color: #C2185B; }
QPushButton#btnTracken:pressed { background-color: #880E4F; }
   </string>
  </property>

