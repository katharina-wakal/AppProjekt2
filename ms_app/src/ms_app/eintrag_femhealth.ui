 <class>EintragWindow</class>
 <widget class="QWidget" name="EintragWindow">
  <property name="geometry">
   <rect><x>0</x><y>0</y><width>390</width><height>844</height></rect>
  </property>
  <property name="windowTitle">
   <string>Eintrag – FemHealth</string>
  </property>
  <property name="styleSheet">
   <string notr="true">
/* ══ Global ══ */
QWidget {
    font-family: "Segoe UI", Arial, sans-serif;
}
QWidget#EintragWindow {
    background-color: #FDF6F0;
}
QWidget#scrollContents,
QWidget#gefuehleContents, QWidget#schmerzenContents,
QWidget#sexlebenContents, QWidget#ausflussContents,
QWidget#hautContents, QWidget#verdauungContents,
QWidget#testsContents, QWidget#pilleContents,
QWidget#spiraleContents, QWidget#pflasterContents,
QWidget#ringContents {
    background-color: #FDF6F0;
}

/* ══ Header ══ */
QFrame#headerFrame {
    background: qlineargradient(x1:0,y1:0,x2:1,y2:1,
        stop:0 #FCE4EC, stop:0.5 #F8BBD9, stop:1 #F48FB1);
    border: none;
}
QPushButton#btnClose {
    background: rgba(255,255,255,0.35);
    border: none;
    border-radius: 16px;
    color: #880E4F;
    font-size: 18px;
    font-weight: bold;
}
QPushButton#btnClose:hover { background: rgba(255,255,255,0.55); }
QLabel#lblHeaderDate {
    color: #FFFFFF;
    font-size: 16px;
    font-weight: bold;
    background: transparent;
}
QLabel#lblTodayBadge {
    background: rgba(255,255,255,0.35);
    color: #880E4F;
    border: 1.5px solid #880E4F;
    border-radius: 8px;
    font-size: 12px;
    font-weight: bold;
    padding: 2px 6px;
}

/* ══ Wochenstreifen ══ */
QFrame#weekFrame {
    background: #FDF6F0;
    border-bottom: 1px solid #F8BBD9;
}
QPushButton#dayToday {
    background: transparent;
    border: 2px solid #E91E63;
    border-radius: 10px;
    color: #E91E63;
    font-size: 13px;
    font-weight: 700;
}
QPushButton#btnDay25, QPushButton#btnDay27, QPushButton#btnDay28,
QPushButton#btnDay29, QPushButton#btnDay30, QPushButton#btnDay31 {
    background: transparent;
    border: none;
    color: #CBA8B5;
    font-size: 13px;
    border-radius: 10px;
}
QPushButton#btnDay25:hover, QPushButton#btnDay27:hover,
QPushButton#btnDay28:hover, QPushButton#btnDay29:hover,
QPushButton#btnDay30:hover, QPushButton#btnDay31:hover {
    background: #FCE4EC;
}
QLabel#wdM1, QLabel#wdD1, QLabel#wdM2, QLabel#wdD2,
QLabel#wdF, QLabel#wdS1, QLabel#wdS2 {
    color: #C2A0AD;
    font-size: 11px;
    font-weight: 600;
    background: transparent;
}

/* ══ Personalisieren ══ */
QPushButton#btnPersonalisieren {
    background: #FFFFFF;
    color: #AD1457;
    border: 1.5px solid #F48FB1;
    border-radius: 14px;
    font-size: 12px;
    font-weight: 600;
    padding: 0 14px;
    min-height: 28px;
}
QPushButton#btnPersonalisieren:hover { background: #FCE4EC; }

/* ══ Scroll ══ */
QScrollArea {
    background: transparent;
    border: none;
}
QScrollBar:vertical {
    width: 4px; background: #F8BBD9; border-radius: 2px;
}
QScrollBar::handle:vertical {
    background: #F48FB1; border-radius: 2px; min-height: 20px;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QScrollBar:horizontal { height: 0px; }

/* ══ Kategorie-Labels ══ */
QLabel#lblKatPeriode, QLabel#lblKatSchmier, QLabel#lblKatGefuehle,
QLabel#lblKatSchmerzen, QLabel#lblKatSexleben, QLabel#lblKatNotizen,
QLabel#lblKatAusfluss, QLabel#lblKatHaut, QLabel#lblKatVerdauung,
QLabel#lblKatStuhlgang, QLabel#lblKatTests, QLabel#lblKatPille,
QLabel#lblKatSpirale, QLabel#lblKatSpritze, QLabel#lblKatImplantat,
QLabel#lblKatPflaster, QLabel#lblKatRing {
    color: #880E4F;
    font-size: 15px;
    font-weight: bold;
    background: transparent;
}

/* ══ Mehr-erfahren-Links ══ */
QPushButton#btnMehrPeriode, QPushButton#btnMehrSchmier,
QPushButton#btnMehrGefuehle, QPushButton#btnMehrSchmerzen,
QPushButton#btnMehrSexleben, QPushButton#btnMehrAusfluss,
QPushButton#btnMehrHaut, QPushButton#btnMehrVerdauung,
QPushButton#btnMehrStuhlgang, QPushButton#btnMehrTests,
QPushButton#btnMehrPille, QPushButton#btnMehrSpirale,
QPushButton#btnMehrSpritze, QPushButton#btnMehrImplantat,
QPushButton#btnMehrPflaster, QPushButton#btnMehrRing {
    background: transparent;
    border: none;
    color: #F48FB1;
    font-size: 12px;
}
QPushButton#btnMehrPeriode:hover, QPushButton#btnMehrSchmier:hover,
QPushButton#btnMehrGefuehle:hover, QPushButton#btnMehrSchmerzen:hover,
QPushButton#btnMehrSexleben:hover, QPushButton#btnMehrAusfluss:hover,
QPushButton#btnMehrHaut:hover, QPushButton#btnMehrVerdauung:hover,
QPushButton#btnMehrStuhlgang:hover, QPushButton#btnMehrTests:hover,
QPushButton#btnMehrPille:hover, QPushButton#btnMehrSpirale:hover,
QPushButton#btnMehrSpritze:hover, QPushButton#btnMehrImplantat:hover,
QPushButton#btnMehrPflaster:hover, QPushButton#btnMehrRing:hover {
    color: #AD1457;
}

/* ══ ALLE Auswahl-Karten – einheitlicher Stil über property ══ */
QPushButton[card="true"] {
    background: #FFFFFF;
    border: 1.5px solid #F8BBD9;
    border-radius: 14px;
    color: #AD1457;
    font-size: 11px;
    font-weight: 600;
    min-width: 78px;
    max-width: 78px;
    min-height: 86px;
    max-height: 86px;
    padding: 4px;
}
QPushButton[card="true"]:checked {
    background: qlineargradient(x1:0,y1:0,x2:1,y2:1,
        stop:0 #FCE4EC, stop:1 #F8BBD9);
    border: 2px solid #E91E63;
    color: #880E4F;
}
QPushButton[card="true"]:hover {
    background: #FFF0F5;
    border-color: #F48FB1;
}

/* ══ Trennlinien ══ */
QFrame[divider="true"] {
    background: #F8BBD9;
    max-height: 1px;
    min-height: 1px;
    border: none;
}

/* ══ Notiz-Box ══ */
QTextEdit#txtNotiz {
    background: #FFFFFF;
    border: 1.5px solid #F8BBD9;
    border-radius: 14px;
    color: #880E4F;
    font-size: 13px;
    padding: 10px;
}
QTextEdit#txtNotiz:focus {
    border: 2px solid #E91E63;
}

/* ══ Speichern ══ */
QPushButton#btnSpeichern {
    background: #E91E63;
    color: #FFFFFF;
    border: none;
    border-radius: 24px;
    font-size: 16px;
    font-weight: 700;
    min-height: 52px;
}
QPushButton#btnSpeichern:hover { background: #C2185B; }
QPushButton#btnSpeichern:pressed { background: #880E4F; }
