<ui version="4.0">
 <class>FemHealthDashboard</class>
 <widget class="QWidget" name="FemHealthDashboard">
  <property name="geometry">
   <rect><x>0</x><y>0</y><width>403</width><height>844</height></rect>
  </property>
  <property name="windowTitle">
   <string>FemHealth – Dashboard</string>
  </property>
  <property name="styleSheet">
   <string notr="true">
QWidget#FemHealthDashboard {
    background-color: #FDF6F0;
    font-family: "Segoe UI", Arial, sans-serif;
}
QWidget#scrollContents {
    background-color: #FDF6F0;
}

/* ── Help-Button ── */
QPushButton#btnHelp {
    background-color: #F0F0F0; color: #9E9E9E;
    border-radius: 20px; font-size: 16px; font-weight: bold; border: none;
}
QPushButton#btnHelp:hover { background-color: #E0E0E0; }
QPushButton#btnHelp:pressed { background-color: #BDBDBD; }

/* ── Einstellungen-Button ── */
QPushButton#btnSettings {
    background-color: #F0F0F0; color: #9E9E9E;
    border-radius: 20px; font-size: 18px; border: none;
}
QPushButton#btnSettings:hover { background-color: #FCE4EC; color: #E91E63; }
QPushButton#btnSettings:pressed { background-color: #F8BBD9; }

/* ── Prognose-Karte ── */
QFrame#framePrognose {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 #FCE4EC, stop:0.5 #F8BBD9, stop:1 #F48FB1);
    border-radius: 24px; border: none;
}
QLabel#lblPrognoseTitle {
    color: #880E4F; font-size: 11px; font-weight: 700;
    letter-spacing: 1px; background: transparent;
}
QLabel#lblCyclePhase {
    color: #AD1457; font-size: 20px; font-weight: bold; background: transparent;
}
QLabel#lblPrognoseInfo { color: #880E4F; font-size: 13px; background: transparent; }
QLabel#lblDaysInfo { color: #C2185B; font-size: 13px; font-weight: bold; background: transparent; }
QLabel#lblCycleDay { color: #AD1457; font-size: 12px; font-weight: bold; background: transparent; }
QLabel#lblTip {
    color: #880E4F; font-size: 11px;
    background: rgba(255,255,255,0.55);
    border-radius: 20px; padding: 6px 14px;
}

/* ── Titel &amp; Begrüßung ── */
QLabel#lblAppTitle { color: #E91E63; font-size: 22px; font-weight: bold; background: transparent; }
QLabel#lblGreeting { color: #9E9E9E; font-size: 13px; background: transparent; }
QLabel#lblSectionTitle {
    color: #757575; font-size: 12px; font-weight: 700;
    letter-spacing: 1px; background: transparent;
}

/* ── Filter-Chips ── */
QPushButton#chipAlle, QPushButton#chipEndo, QPushButton#chipSTI,
QPushButton#chipZyklus, QPushButton#chipMental, QPushButton#chipErnaehrung {
    background-color: #FFFFFF; color: #AD1457; border-radius: 16px;
    font-size: 12px; font-weight: 600; border: 1.5px solid #F48FB1; padding: 4px 13px;
}
QPushButton#chipAlle:checked, QPushButton#chipEndo:checked, QPushButton#chipSTI:checked,
QPushButton#chipZyklus:checked, QPushButton#chipMental:checked, QPushButton#chipErnaehrung:checked {
    background-color: #F48FB1; color: #FFFFFF; border-color: #F48FB1;
}
QPushButton#chipAlle:hover, QPushButton#chipEndo:hover, QPushButton#chipSTI:hover,
QPushButton#chipZyklus:hover, QPushButton#chipMental:hover, QPushButton#chipErnaehrung:hover {
    background-color: #FCE4EC;
}

/* ── News-Karten ── */
QFrame#newsCard1, QFrame#newsCard2, QFrame#newsCard3,
QFrame#newsCard4, QFrame#newsCard5 {
    background-color: #FFFFFF; border-radius: 16px; border: 1px solid #F8BBD9;
}
QFrame#newsCard1:hover, QFrame#newsCard2:hover, QFrame#newsCard3:hover,
QFrame#newsCard4:hover, QFrame#newsCard5:hover { background-color: #FFF5F8; }
QLabel#newsCat1, QLabel#newsCat3 {
    color: #F48FB1; font-size: 10px; font-weight: 700; letter-spacing: 1px; background: transparent;
}
QLabel#newsCat2, QLabel#newsCat5 {
    color: #AB47BC; font-size: 10px; font-weight: 700; letter-spacing: 1px; background: transparent;
}
QLabel#newsCat4 {
    color: #1976D2; font-size: 10px; font-weight: 700; letter-spacing: 1px; background: transparent;
}
QLabel#newsTitle1, QLabel#newsTitle3 {
    color: #AD1457; font-size: 13px; font-weight: 700; background: transparent;
}
QLabel#newsTitle2, QLabel#newsTitle5 {
    color: #6A1B9A; font-size: 13px; font-weight: 700; background: transparent;
}
QLabel#newsTitle4 { color: #0D47A1; font-size: 13px; font-weight: 700; background: transparent; }
QLabel#newsSub1, QLabel#newsSub2, QLabel#newsSub3,
QLabel#newsSub4, QLabel#newsSub5 { color: #9E9E9E; font-size: 11px; background: transparent; }
QLabel#newsArrow1, QLabel#newsArrow2, QLabel#newsArrow3,
QLabel#newsArrow4, QLabel#newsArrow5 { color: #F48FB1; font-size: 18px; background: transparent; }

/* ── Social-Media ── */
QFrame#frameSocial {
    background-color: #FFFFFF; border-radius: 16px; border: 1px solid #F8BBD9;
}
QLabel#lblSocialTitle {
    color: #9E9E9E; font-size: 11px; font-weight: 700; letter-spacing: 1px; background: transparent;
}
QPushButton#btnInstagram, QPushButton#btnX, QPushButton#btnTikTok {
    background-color: #FCE4EC; color: #AD1457; border-radius: 12px;
    font-size: 12px; font-weight: 700; border: 1.5px solid #F48FB1; padding: 6px 14px;
}
QPushButton#btnInstagram:hover, QPushButton#btnX:hover, QPushButton#btnTikTok:hover {
    background-color: #F48FB1; color: #FFFFFF;
}
QPushButton#btnInstagram:pressed, QPushButton#btnX:pressed, QPushButton#btnTikTok:pressed {
    background-color: #E91E63; color: #FFFFFF;
}

/* ── Scroll ── */
QScrollArea { background: transparent; border: none; }
QScrollBar:vertical { width: 4px; background: #F8BBD9; border-radius: 2px; }
QScrollBar::handle:vertical { background: #F48FB1; border-radius: 2px; min-height: 20px; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QScrollBar:horizontal { height: 0px; }

/* ── Bottom-Navigation ── */
QFrame#frameNavBar {
    background-color: #FFFFFF;
    border-top: 1px solid #F0E0E8;
}
QPushButton#navHome {
    color: #E91E63; background: #FCE4EC;
    border-radius: 12px; border: none; font-size: 11px;
}
QPushButton#navKalender, QPushButton#navArzt, QPushButton#navAnalyse {
    color: #BDBDBD; background: transparent; border: none; font-size: 11px;
}
QPushButton#navKalender:hover, QPushButton#navArzt:hover, QPushButton#navAnalyse:hover {
    color: #AD1457;
}
QPushButton#navTracken {
    background: qlineargradient(x1:0,y1:0,x2:1,y2:1,
        stop:0 #E91E63, stop:1 #C2185B);
    color: #FFFFFF; border: none; border-radius: 16px;
    font-size: 11px; font-weight: bold;
    min-width: 66px; max-width: 66px;
    min-height: 52px; max-height: 52px;
}
QPushButton#navTracken:hover { background: #C2185B; }
QPushButton#navTracken:pressed { background: #880E4F; }
   </string>
  </property>

