<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>AnalyseWindow</class>
 <widget class="QWidget" name="AnalyseWindow">
  <property name="geometry">
   <rect>
    <x>0</x>
    <y>0</y>
    <width>390</width>
    <height>844</height>
   </rect>
  </property>
  <property name="windowTitle">
   <string>Analyse – FemHealth</string>
  </property>
  <property name="styleSheet">
   <string notr="true">
/* ══ Global ══ */
QWidget {
    font-family: &quot;Segoe UI&quot;, Arial, sans-serif;
}
QWidget#AnalyseWindow {
    background-color: #FDF6F0;
}
QWidget#scrollContents {
    background-color: #FDF6F0;
}

/* ══ Header ══ */
QLabel#lblAppTitle {
    color: #E91E63;
    font-size: 22px;
    font-weight: bold;
    background: transparent;
}
QLabel#lblPageTitle {
    color: #9E9E9E;
    font-size: 13px;
    background: transparent;
}
QPushButton#btnBack {
    background-color: #BDBDBD;
    color: #FFFFFF;
    border-radius: 20px;
    font-size: 16px;
    font-weight: bold;
    border: none;
}
QPushButton#btnBack:hover { background-color: #9E9E9E; }
QPushButton#btnBack:pressed { background-color: #757575; }

/* ══ Statistik-Hauptkarte (Gradient) ══ */
QFrame#frameStatistik {
    background: qlineargradient(
        x1:0, y1:0, x2:1, y2:1,
        stop:0 #FCE4EC,
        stop:0.5 #F8BBD9,
        stop:1 #F48FB1
    );
    border-radius: 24px;
    border: none;
}
QLabel#lblStatTitle {
    color: #880E4F;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1px;
    background: transparent;
}
QLabel#lblStatSubInfo {
    color: #880E4F;
    font-size: 12px;
    background: transparent;
}
QLabel#lblStatTrend {
    color: #880E4F;
    font-size: 11px;
    background: rgba(255,255,255,0.55);
    border-radius: 20px;
    padding: 6px 14px;
}
QLabel#lblStatScore {
    color: #AD1457;
    font-size: 24px;
    font-weight: bold;
    background: transparent;
}
QLabel#lblStatScoreSub {
    color: #880E4F;
    font-size: 12px;
    background: transparent;
}

/* ══ Abschnitt-Titel ══ */
QLabel#lblSekStatistiken,
QLabel#lblSekPrognose,
QLabel#lblSekTrend,
QLabel#lblSekSymptome,
QLabel#lblSekInsights,
QLabel#lblSekVergleich {
    color: #880E4F;
    font-size: 15px;
    font-weight: bold;
    background: transparent;
}
QLabel#lblSekSub {
    color: #9E9E9E;
    font-size: 12px;
    background: transparent;
}

/* ══ Info-Karten (weiß mit rosa Rand) ══ */
QFrame#cardZyklusDauer,
QFrame#cardSchwankung,
QFrame#cardPeriodeDauer,
QFrame#cardScore,
QFrame#cardPrognose,
QFrame#cardEissprung,
QFrame#cardPMS,
QFrame#cardInsight1,
QFrame#cardInsight2,
QFrame#cardTrend,
QFrame#cardSymptom1,
QFrame#cardSymptom2,
QFrame#cardSymptom3,
QFrame#cardVergleich {
    background-color: #FFFFFF;
    border-radius: 18px;
    border: 1px solid #F8BBD9;
}

/* ══ Karten-Texte ══ */
QLabel#lblKartenTitel {
    color: #757575;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1px;
    background: transparent;
}
QLabel#lblZyklusDauerTitle,
QLabel#lblSchwankungTitle,
QLabel#lblPeriodeDauerTitle,
QLabel#lblScoreTitle,
QLabel#lblPrognoseTitle,
QLabel#lblEissprungTitle,
QLabel#lblPMSTitle,
QLabel#lblInsight1Title,
QLabel#lblInsight2Title,
QLabel#lblTrendTitle,
QLabel#lblSymptom1Title,
QLabel#lblSymptom2Title,
QLabel#lblSymptom3Title {
    color: #9E9E9E;
    font-size: 11px;
    background: transparent;
}
QLabel#lblZyklusDauerWert,
QLabel#lblSchwankungWert,
QLabel#lblPeriodeDauerWert {
    color: #AD1457;
    font-size: 22px;
    font-weight: bold;
    background: transparent;
}
QLabel#lblScoreWert {
    color: #E91E63;
    font-size: 26px;
    font-weight: bold;
    background: transparent;
}
QLabel#lblPrognoseWert,
QLabel#lblEissprungWert {
    color: #AD1457;
    font-size: 14px;
    font-weight: bold;
    background: transparent;
}
QLabel#lblPrognoseGenau,
QLabel#lblEissprungInfo,
QLabel#lblPMSWert,
QLabel#lblInsight1Text,
QLabel#lblInsight2Text,
QLabel#lblTrendText,
QLabel#lblSymptom1Text,
QLabel#lblSymptom2Text,
QLabel#lblSymptom3Text,
QLabel#lblKorrelation {
    color: #757575;
    font-size: 12px;
    background: transparent;
}

/* ══ Status-Badges ══ */
QLabel#badgeTypisch {
    background-color: #E8F5E9;
    color: #2E7D32;
    border-radius: 10px;
    font-size: 11px;
    font-weight: bold;
    padding: 3px 8px;
}
QLabel#badgeUntypisch {
    background-color: #FFF3E0;
    color: #E65100;
    border-radius: 10px;
    font-size: 11px;
    font-weight: bold;
    padding: 3px 8px;
}
QLabel#badgeStabil {
    background-color: #FCE4EC;
    color: #AD1457;
    border-radius: 10px;
    font-size: 11px;
    font-weight: bold;
    padding: 3px 8px;
}

/* ══ Ring-Platzhalter ══ */
QLabel#ringZyklusDauer {
    border: 4px solid #64B5F6;
    border-radius: 26px;
    background: transparent;
    color: #64B5F6;
    font-size: 14px;
    font-weight: bold;
}
QLabel#ringSchwankung {
    border: 4px solid #FF9800;
    border-radius: 26px;
    background: transparent;
    color: #FF9800;
    font-size: 14px;
    font-weight: bold;
}
QLabel#ringPeriode {
    border: 4px solid #E91E63;
    border-radius: 20px;
    background: transparent;
    color: #E91E63;
    font-size: 12px;
}

/* ══ Trend-Grafik-Platzhalter ══ */
QLabel#lblTrendChart {
    background: #FDF6F0;
    border-radius: 10px;
    color: #BDBDBD;
    font-size: 11px;
    padding: 8px;
}
QLabel#lblVergleichBar {
    background: #FDF6F0;
    border-radius: 10px;
    color: #BDBDBD;
    font-size: 11px;
    padding: 8px;
}

/* ══ Mehr-erfahren-Links ══ */
QPushButton#btnMehrPeriode,
QPushButton#btnMehrTrend,
QPushButton#btnMehrInsights {
    background: transparent;
    border: none;
    color: #F48FB1;
    font-size: 12px;
    text-align: left;
}
QPushButton#btnMehrPeriode:hover,
QPushButton#btnMehrTrend:hover,
QPushButton#btnMehrInsights:hover {
    color: #AD1457;
}

/* ══ Pfeil-Icons ══ */
QLabel#lblPfeil1,
QLabel#lblPfeil2,
QLabel#lblPfeil3,
QLabel#lblPfeil4 {
    color: #F48FB1;
    font-size: 18px;
    background: transparent;
}

/* ══ Freischalten-Button ══ */
QPushButton#btnFreischalten {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #E91E63, stop:1 #F48FB1);
    color: #FFFFFF;
    border: none;
    border-radius: 24px;
    font-size: 15px;
    font-weight: bold;
    min-height: 52px;
}
QPushButton#btnFreischalten:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #C2185B, stop:1 #E91E63);
}
QPushButton#btnFreischalten:pressed { background: #880E4F; }

/* ══ Scroll ══ */
QScrollArea {
    background: transparent;
    border: none;
}
QScrollBar:vertical {
    width: 4px; background: #F8BBD9; border-radius: 2px;
}
QScrollBar::handle:vertical {
    background: #F48FB1; border-radius: 2px; min-height: 20px;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QScrollBar:horizontal { height: 0px; }

/* ══ Bottom Navigation ══ */
QFrame#frameNavBar {
    background-color: #FFFFFF;
    border-top: 1px solid #F0E0E8;
}
QPushButton#navHome,
QPushButton#navKalender,
QPushButton#navTracken,
QPushButton#navArzt {
    color: #BDBDBD;
    background: transparent;
    border: none;
    font-size: 11px;
}
QPushButton#navHome:hover,
QPushButton#navKalender:hover,
QPushButton#navTracken:hover,
QPushButton#navArzt:hover {
    color: #AD1457;
}
QPushButton#navAnalyse {
    color: #E91E63;
    background: #FCE4EC;
    border-radius: 12px;
    border: none;
    font-size: 11px;
}
QPushButton#navTrackenMain {
    background: qlineargradient(x1:0,y1:0,x2:1,y2:1,
        stop:0 #E91E63, stop:1 #C2185B);
    color: #FFFFFF;
    border: none;
    border-radius: 16px;
    font-size: 11px;
    font-weight: bold;
    min-width: 66px;
    max-width: 66px;
    min-height: 52px;
    max-height: 52px;
}
QPushButton#navTrackenMain:hover { background: #C2185B; }
QPushButton#navTrackenMain:pressed { background: #880E4F; }
