<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>KalenderWindow</class>
 <widget class="QWidget" name="KalenderWindow">
  <property name="geometry">
   <rect>
    <x>0</x>
    <y>0</y>
    <width>390</width>
    <height>844</height>
   </rect>
  </property>
  <property name="windowTitle">
   <string>Kalender – FemHealth</string>
  </property>
  <property name="styleSheet">
   <string notr="true">
/* ══ Global ══ */
QWidget#KalenderWindow {
    background-color: #FDF6F0;
    font-family: "Segoe UI", Arial, sans-serif;
}

/* ══ Top bar ══ */
QFrame#headerFrame {
    background-color: qlineargradient(
        spread:pad, x1:0, y1:0, x2:1, y2:1,
        stop:0 #FCE4EC, stop:0.5 #F8BBD9, stop:1 #F48FB1
    );
    border-bottom-left-radius: 0px;
    border-bottom-right-radius: 0px;
}
QPushButton#btnBack {
    background-color: rgba(255,255,255,0.35);
    border: none;
    border-radius: 18px;
    color: #880E4F;
    font-size: 18px;
    font-weight: bold;
}
QPushButton#btnBack:hover { background-color: rgba(255,255,255,0.55); }
QLabel#lblTitle {
    color: #FFFFFF;
    font-size: 18px;
    font-weight: bold;
    background: transparent;
}

/* ══ Legend ══ */
QFrame#legendFrame {
    background: transparent;
    border: none;
}
QLabel#legPeriode  { color: #E91E63; font-size: 10px; background: transparent; }
QLabel#legEisprung { color: #1565C0; font-size: 10px; background: transparent; }
QLabel#legEintrag  { color: #F48FB1; font-size: 10px; background: transparent; }

/* ══ Calendar scroll area ══ */
QScrollArea#calScrollArea {
    background: transparent;
    border: none;
}
QScrollArea#calScrollArea > QWidget > QWidget {
    background: transparent;
}
QScrollBar:vertical {
    width: 4px;
    background: #F8BBD9;
    border-radius: 2px;
}
QScrollBar::handle:vertical {
    background: #F48FB1;
    border-radius: 2px;
    min-height: 20px;
}
QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical { height: 0; }

/* ══ Month label ══ */
QLabel#lblMonth {
    color: #880E4F;
    font-size: 14px;
    font-weight: bold;
    background: transparent;
    padding: 8px 0 4px;
}

/* ══ Weekday headers ══ */
QLabel.weekdayHeader {
    color: #C2A0AD;
    font-size: 10px;
    font-weight: 600;
    background: transparent;
    qproperty-alignment: AlignCenter;
}

/*
  ══ Day cells – implemented as QPushButton in a QGridLayout ══

  Normal day:
*/
QPushButton.dayBtn {
    background: transparent;
    border: none;
    border-radius: 10px;
    font-size: 13px;
    font-weight: 500;
    color: #4A0010;
    min-height: 40px;
    max-height: 40px;
}
QPushButton.dayBtn:hover { background: #FCE4EC; }

/* Today */
QPushButton.dayToday {
    color: #E91E63;
    font-weight: 700;
    border-bottom: 3px solid #E91E63;
}

/* Period days */
QPushButton.dayPeriod {
    background-color: #E91E63;
    color: #FFFFFF;
    border-radius: 2px;
}
QPushButton.dayPeriodStart  { border-radius: 10px 2px 2px 10px; }
QPushButton.dayPeriodEnd    { border-radius: 2px 10px 10px 2px; }
QPushButton.dayPeriod:hover { background-color: #C2185B; }

/* Ovulation zone (hellblau) */
QPushButton.dayOvulationZone {
    background-color: #E3F2FD;
    color: #1565C0;
    border-radius: 2px;
}
QPushButton.dayOvulationZoneStart { border-radius: 10px 2px 2px 10px; }
QPushButton.dayOvulationZoneEnd   { border-radius: 2px 10px 10px 2px; }

/* Ovulation peak (blauer Punkt oben rechts – via subLabel im Code) */
QPushButton.dayOvulationPeak {
    background-color: #BBDEFB;
    color: #0D47A1;
    font-weight: 700;
}

/* Future (ausgegraut) */
QPushButton.dayFuture {
    color: #CBA8B5;
}
QPushButton.dayFuture:hover { background: transparent; }

/* Selected */
QPushButton.daySelected {
    outline: 2px solid #E91E63;
}

/* ══ Detail bottom sheet ══ */
QFrame#sheetFrame {
    background-color: #FFFFFF;
    border-top: 1.5px solid #F8BBD9;
    border-top-left-radius: 20px;
    border-top-right-radius: 20px;
}
QLabel#sheetHandle {
    background: #F8BBD9;
    border-radius: 2px;
    max-height: 4px;
    min-height: 4px;
    max-width: 36px;
    min-width: 36px;
}
QLabel#sheetDate {
    color: #880E4F;
    font-size: 14px;
    font-weight: bold;
    background: transparent;
}
QLabel#sheetCycleDay {
    color: #F48FB1;
    font-size: 11px;
    font-weight: 600;
    background: transparent;
    margin-bottom: 8px;
}
QLabel#sheetSectionLbl {
    color: #BDBDBD;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 1px;
    background: transparent;
    margin-top: 8px;
}
/* Intensity dots */
QPushButton.intensityDot {
    min-width: 22px;
    max-width: 22px;
    min-height: 22px;
    max-height: 22px;
    border-radius: 11px;
    border: 2px solid #F8BBD9;
    background: #FFFFFF;
    font-size: 10px;
    color: #9E9E9E;
}
QPushButton.intensityDotFilled {
    background: #E91E63;
    border: 2px solid #E91E63;
    color: #FFFFFF;
}
/* Symptom / mood tags */
QPushButton.tagRed {
    background: #FCE4EC;
    color: #AD1457;
    border: none;
    border-radius: 20px;
    padding: 4px 10px;
    font-size: 11px;
    font-weight: 600;
}
QPushButton.tagGray {
    background: #F5F5F5;
    color: #757575;
    border: none;
    border-radius: 20px;
    padding: 4px 10px;
    font-size: 11px;
}
QLabel#sheetNote {
    color: #9E9E9E;
    font-size: 12px;
    font-style: italic;
    background: #FFF5F8;
    border-radius: 8px;
    padding: 8px 10px;
    border-left: 3px solid #F48FB1;
}
QPushButton#btnAddEntry {
    background: #FFF5F8;
    color: #AD1457;
    border: 1.5px solid #F48FB1;
    border-radius: 12px;
    font-size: 13px;
    font-weight: 600;
    min-height: 40px;
}
QPushButton#btnAddEntry:hover { background: #FCE4EC; }
   </string>
  </property>

