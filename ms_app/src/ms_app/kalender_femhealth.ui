  <!-- ════ CALENDAR SCROLL AREA ════
       In Qt: QScrollArea → QWidget → QVBoxLayout
       Für jeden Monat: QLabel (Monat), QGridLayout (Wochentage + Tage)

       Jeder Tag ist ein QPushButton mit dynamisch gesetzten CSS-Klassen:
         - dayBtn         → Basis-Stil
         - dayToday       → heute
         - dayPeriod / dayPeriodStart / dayPeriodEnd  → Periode (rot)
         - dayOvulationZone / dayOvulationPeak        → Eisprung (blau)
         - dayFuture      → zukünftige Tage (ausgegraut, nicht klickbar)
         - daySelected    → aktuell ausgewählt

       Für den Eisprung-Peak: kleinen QLabel (8×8 px, border-radius 4px,
       background #1976D2) als Overlay oben rechts auf den Button legen.

       Hinweis: Diese .ui-Datei definiert nur den statischen Rahmen.
       Die Monatsgitter werden per Python/C++ Code dynamisch befüllt
       (calculatePeriods, calculateOvulation, renderMonth).
  ════ -->
  <widget class="QScrollArea" name="calScrollArea">
   <property name="geometry">
    <rect><x>0</x><y>116</y><width>390</width><height>448</height></rect>
   </property>
   <property name="widgetResizable"><bool>true</bool></property>
   <property name="horizontalScrollBarPolicy"><enum>Qt::ScrollBarAlwaysOff</enum></property>

   <widget class="QWidget" name="calContents">
    <property name="geometry">
     <rect><x>0</x><y>0</y><width>390</width><height>800</height></rect>
    </property>
    <!-- Inhalt wird per Code (Python/C++) dynamisch generiert -->
    <!-- Beispiel-Platzhalter für einen Monatsblock: -->
    <widget class="QLabel" name="lblPlaceholderInfo">
     <property name="geometry">
      <rect><x>20</x><y>20</y><width>350</width><height>60</height></rect>
     </property>
     <property name="text">
      <string>[ Kalender-Monate werden per Code dynamisch generiert.
Für jeden Monat: QLabel + QGridLayout mit QPushButton-Tagen. ]</string>
     </property>
     <property name="wordWrap"><bool>true</bool></property>
     <property name="alignment"><set>AlignCenter</set></property>
     <property name="styleSheet"><string notr="true">color:#C2A0AD;font-size:11px;background:transparent;</string></property>
    </widget>
   </widget>
  </widget>

