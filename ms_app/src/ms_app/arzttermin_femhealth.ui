  <property name="styleSheet">
   <string notr="true">
/* ══ Global ══ */
QWidget {
    font-family: "Segoe UI", Arial, sans-serif;
}
QWidget#ArztterminWindow {
    background-color: #FDF6F0;
}
QWidget#scrollContents {
    background-color: #FDF6F0;
}

/* ══ Header ══ */
QFrame#headerFrame {
    background: qlineargradient(x1:0,y1:0,x2:1,y2:1,
        stop:0 #FCE4EC, stop:0.5 #F8BBD9, stop:1 #F48FB1);
    border: none;
}
QPushButton#btnClose {
    background: rgba(255,255,255,0.35);
    border: none;
    border-radius: 16px;
    color: #880E4F;
    font-size: 18px;
    font-weight: bold;
}
QPushButton#btnClose:hover { background: rgba(255,255,255,0.55); }
QLabel#lblHeaderTitle {
    color: #FFFFFF;
    font-size: 16px;
    font-weight: bold;
    background: transparent;
}
QLabel#lblHeaderIcon {
    color: #FFFFFF;
    font-size: 22px;
    background: transparent;
}

/* ══ Wochenstreifen ══ */
QFrame#weekFrame {
    background: #FDF6F0;
    border-bottom: 1px solid #F8BBD9;
}
QPushButton#dayToday {
    background: transparent;
    border: 2px solid #E91E63;
    border-radius: 10px;
    color: #E91E63;
    font-size: 13px;
    font-weight: 700;
}
QPushButton#btnDay1,
QPushButton#btnDay2,
QPushButton#btnDay3,
QPushButton#btnDay4,
QPushButton#btnDay5,
QPushButton#btnDay6 {
    background: transparent;
    border: none;
    color: #CBA8B5;
    font-size: 13px;
    border-radius: 10px;
}
QPushButton#btnDay1:hover,
QPushButton#btnDay2:hover,
QPushButton#btnDay3:hover,
QPushButton#btnDay4:hover,
QPushButton#btnDay5:hover,
QPushButton#btnDay6:hover {
    background: #FCE4EC;
}
QLabel#wdMo, QLabel#wdDi, QLabel#wdMi,
QLabel#wdDo, QLabel#wdFr, QLabel#wdSa, QLabel#wdSo {
    color: #C2A0AD;
    font-size: 11px;
    font-weight: 600;
    background: transparent;
}

/* ══ Scroll ══ */
QScrollArea {
    background: transparent;
    border: none;
}
QScrollBar:vertical {
    width: 4px; background: #F8BBD9; border-radius: 2px;
}
QScrollBar::handle:vertical {
    background: #F48FB1; border-radius: 2px; min-height: 20px;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QScrollBar:horizontal { height: 0px; }

/* ══ Abschnitt-Labels ══ */
QLabel#lblSekArztDetail,
QLabel#lblSekTermin,
QLabel#lblSekNotiz,
QLabel#lblSekErinnerung,
QLabel#lblSekBefund {
    color: #880E4F;
    font-size: 15px;
    font-weight: bold;
    background: transparent;
}

/* ══ Eingabefelder ══ */
QLineEdit#txtArztName,
QLineEdit#txtOrt {
    background: #FFFFFF;
    border: 1.5px solid #F8BBD9;
    border-radius: 14px;
    color: #880E4F;
    font-size: 13px;
    padding: 8px 14px;
    min-height: 38px;
}
QLineEdit#txtArztName:focus,
QLineEdit#txtOrt:focus {
    border: 2px solid #E91E63;
}

/* ══ ComboBox ══ */
QComboBox#cmbArztTyp {
    background: #FFFFFF;
    border: 1.5px solid #F8BBD9;
    border-radius: 14px;
    color: #880E4F;
    font-size: 13px;
    padding: 6px 14px;
    min-height: 38px;
}
QComboBox#cmbArztTyp:focus {
    border: 2px solid #E91E63;
}
QComboBox#cmbArztTyp::drop-down {
    border: none;
    width: 28px;
}
QComboBox#cmbArztTyp QAbstractItemView {
    background: #FFFFFF;
    border: 1.5px solid #F8BBD9;
    border-radius: 10px;
    color: #880E4F;
    selection-background-color: #FCE4EC;
    font-size: 13px;
    padding: 4px;
}

/* ══ Datum &amp; Zeit ══ */
QDateEdit#datTermin {
    background: #FFFFFF;
    border: 1.5px solid #F8BBD9;
    border-radius: 14px;
    color: #880E4F;
    font-size: 13px;
    padding: 6px 14px;
    min-height: 38px;
}
QDateEdit#datTermin:focus { border: 2px solid #E91E63; }
QDateEdit#datTermin::drop-down { border: none; width: 28px; }

QTimeEdit#timTermin {
    background: #FFFFFF;
    border: 1.5px solid #F8BBD9;
    border-radius: 14px;
    color: #880E4F;
    font-size: 13px;
    padding: 6px 14px;
    min-height: 38px;
}
QTimeEdit#timTermin:focus { border: 2px solid #E91E63; }
QTimeEdit#timTermin::up-button,
QTimeEdit#timTermin::down-button {
    width: 22px; border: none; background: transparent;
}

/* ══ Notiz-Felder ══ */
QTextEdit#txtNotiz,
QTextEdit#txtVorbereitung,
QTextEdit#txtBefund {
    background: #FFFFFF;
    border: 1.5px solid #F8BBD9;
    border-radius: 14px;
    color: #880E4F;
    font-size: 13px;
    padding: 10px;
}
QTextEdit#txtNotiz:focus,
QTextEdit#txtVorbereitung:focus,
QTextEdit#txtBefund:focus {
    border: 2px solid #E91E63;
}

/* ══ Erinnerungs-Chips ══ */
QPushButton#chip1Tag,
QPushButton#chip3Tage,
QPushButton#chip1Woche,
QPushButton#chipAmTag {
    background-color: #FFFFFF;
    color: #AD1457;
    border-radius: 16px;
    font-size: 12px;
    font-weight: 600;
    border: 1.5px solid #F48FB1;
    padding: 4px 10px;
    min-height: 30px;
}
QPushButton#chip1Tag:checked,
QPushButton#chip3Tage:checked,
QPushButton#chip1Woche:checked,
QPushButton#chipAmTag:checked {
    background-color: #F48FB1;
    color: #FFFFFF;
    border-color: #F48FB1;
}
QPushButton#chip1Tag:hover,
QPushButton#chip3Tage:hover,
QPushButton#chip1Woche:hover,
QPushButton#chipAmTag:hover {
    background-color: #FCE4EC;
}

/* ══ Folgetermin-Chips ══ */
QPushButton#chipFolgeJa,
QPushButton#chipFolgeNein {
    background-color: #FFFFFF;
    color: #AD1457;
    border-radius: 16px;
    font-size: 12px;
    font-weight: 600;
    border: 1.5px solid #F48FB1;
    padding: 4px 10px;
    min-height: 30px;
}
QPushButton#chipFolgeJa:checked,
QPushButton#chipFolgeNein:checked {
    background-color: #F48FB1;
    color: #FFFFFF;
    border-color: #F48FB1;
}
QPushButton#chipFolgeJa:hover,
QPushButton#chipFolgeNein:hover {
    background-color: #FCE4EC;
}

/* ══ Speichern ══ */
QPushButton#btnSpeichern {
    background: #E91E63;
    color: #FFFFFF;
    border: none;
    border-radius: 24px;
    font-size: 16px;
    font-weight: 700;
    min-height: 52px;
}
QPushButton#btnSpeichern:hover  { background: #C2185B; }
QPushButton#btnSpeichern:pressed { background: #880E4F; }
   </string>
